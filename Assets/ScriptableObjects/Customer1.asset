  animatorOverride: {fileID: 22100000, guid: 99046ba76ab45df4e94b8d5e0bc15deb, type: 2}
  openingDialogues:
  - "\uBB50\uC57C, \uC774 \uD3D0\uC5C5 \uC9C1\uC804 \uAC00\uAC8C \uB124 \uAC70\uC600\uC5B4?"
  - "\uD558... \uC774\uB7F0 \uB3D9\uB124\uC5D0 \uACBD\uC7C1\uC790\uAC00 \uC0DD\uACBC\uB2E4\uACE0
    \uAE30\uB300\uD588\uB354\uB2C8."
  - "\uC5BC\uAD74 \uBCF4\uB2C8\uAE4C \uCEE4\uD53C \uBA38\uC2E0 \uC804\uC6D0\uB3C4
    \uBABB \uD0AC \uAC83 \uAC19\uC740\uB370?"
  - "\uC7A0\uAE50 \uC74C\uC545 \uC18C\uB9AC\uAC00 \uB108\uBB34 \uD06C\uC9C0\uC54A\uC544?"
  - "\uD0DC\uBE14\uB9BF\uC73C\uB85C \uC18C\uB9AC \uC880 \uC904\uC5EC!"
  - "\uD760 \uC774\uC81C \uC880 \uB0AB\uAD70"
  - "\uC774\uC81C \uB514\uC800\uD2B8 \uC880 \uB9CC\uB4E4\uC5B4 \uBD10"
  - "\uBB50? \uB808\uC2DC\uD53C\uB97C \uBAA8\uB978\uB2E4\uACE0?"
  - "\uD558...."
  - "\uD0DC\uBE14\uB9BF \uC624\uB978\uCABD \uC778\uD615\uC744 \uB204\uB974\uBA74
    \uB808\uC2DC\uD53C(\uBA38\uC9C0\uB2E8\uACC4)\uAC00 \uB098\uC640 "
  - "\uC774\uC81C \uB9CC\uB4E4 \uC218 \uC788\uACA0\uC9C0? "
  - "\uADF8\uB7FC \uBE68\uB9AC \uB0B4 \uCFE0\uD0A4,\uB3C4\uB11B,\uB864\uCF00\uC78C,\uD504\uB77C\uD478\uCE58\uB178
    \uAC00\uC838\uC640! "
