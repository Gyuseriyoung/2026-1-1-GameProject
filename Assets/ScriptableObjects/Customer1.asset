  chartJson: {fileID: 4900000, guid: 9c55a033726ff6a44a2dfce471bfc6b5, type: 3}
  successDialogue: "\uBB50\uC57C? \uCD5C\uC545\uC774\uC57C!  (\uB9DB\uC788\uB294\uAC78..?)"
  failureDialogue: "\uCD5C\uC545\uC774\uAD70...."
  soliloquies:
  - "\uBB50\uC57C \uC800 \uC190\uB2D8..\uD654\uB0B4\uBA74\uC11C \uB2E4 \uC54C\uB824\uC8FC\uACE0
    \uAC14\uC5B4.."
  - "\uB2E4\uC74C \uC190\uB2D8\uC740 \uBA40\uCA61\uD588\uC73C\uBA74 \uC88B\uACA0\uB124.."
  midPlayDialogues:
  - triggerTimeMs: -1000
    dialogueLines:
    - "\uBC18\uAC00\uC6CC \uB09C \uC774 \uCE74\uD398\uC5D0 \uCD1D\uAD04 \uC170\uD504
      \uD30C\uD30C\uC874\uC2A4\uC57C "
    - "\uC67C\uCABD \uD558\uB2E8\uC5D0 \uC788\uB294 \uCE5C\uAD6C\uB294 \uB9C8\uB974\uCF54,
      \uC7A1\uC77C\uC744 \uB2F4\uB2F9\uD558\uC9C0 "
    - "\uADF8\uB9AC\uACE0 \uB0B4 \uC544\uB798\uC5D0 \uC788\uB294\uAC8C \uBC14\uB85C
      \uB108 (\uD50C\uB808\uC774\uC5B4)\uC57C"
    - "\uC6B0\uB9AC \uAC00\uAC8C\uB294 \uD2B9\uC774\uD558\uAC8C\uB3C4 2\uCE35\uC73C\uB85C
      \uC774\uB8E8\uC5B4\uC838 \uC788\uC5B4"
    - "\uB108\uAC00 \uC788\uB294 1\uCE35\uC740 \uC7AC\uB8CC\uAC00 \uB098\uC624\uB294
      \uCE35\uC774\uC57C  "
    - "\uB0B4\uAC00 \uC788\uB294 2\uCE35\uC740 \uC67C\uCABD \uCC3D\uC5D0\uC11C \uD604\uC7AC
      \uD569\uC131 \uB2E8\uACC4\uB97C \uBCFC \uC218 \uC788\uC9C0 "
    - "\uC911\uAC04\uC5D0 \uC788\uB294 \uB514\uC800\uD2B8 \uC774\uBBF8\uC9C0\uB4E4\uC740
      \uBA38\uC9C0 \uB2E8\uACC4\uB97C \uB098\uD0C0\uB0B8\uAC70\uC57C "
    - "\uC774\uC81C \uD0C0\uC774\uBC0D\uC5D0 \uB9DE\uCDB0 D(\uC704),F(\uC544\uB798)
      \uD0A4\uB97C \uB20C\uB7EC \uD569\uC131\uD560 \uC7AC\uB8CC\uB97C \uC120\uD0DD\uD574
      \uBD10! "
  lightingPreset: {fileID: 0}
